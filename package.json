{
  "name": "alcatraz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Auswertung für Motorbootslalom-Wettkämpfe – läuft vollständig im Browser",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:single": "vue-tsc -b && vite build --mode single",
    "build:all": "npm run build && npm run build:single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "vue-tsc -b && vitest run",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "vue": "^3.5.40",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
